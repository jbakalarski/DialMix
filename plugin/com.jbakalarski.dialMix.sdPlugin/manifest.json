{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Author": "jbakalarski",
  "CodePath": "plugin.js",
  "Description": "Control Windows Core Audio sessions and devices with OpenDeck encoders.",
  "Name": "DialMix",
  "Version": "1.0.0",
  "SDKVersion": 2,
  "UUID": "com.jbakalarski.dialMix",
  "Icon": "images/plugin",
  "Category": "DialMix",
  "Nodejs": { "Version": "20" },
  "OS": [ { "Platform": "windows", "MinimumVersion": "10" } ],
  "Actions": [ {
    "Name": "Audio control",
    "UUID": "com.jbakalarski.dialMix.control",
    "Tooltip": "Control a Windows audio target",
    "Icon": "images/action",
    "States": [ { "Image": "images/action", "ShowTitle": true } ],
    "Encoder": { "layout": "layouts/dialmix.json", "TriggerDescription": { "Push": "Toggle mute", "Rotate": "Adjust volume" } },
    "PropertyInspectorPath": "inspector.html",
    "Controllers": [ "Encoder", "Keypad" ],
    "SupportedInMultiActions": true
  } ]
}
